name: Deploy to GitHub Pages

on:
  push:
    branches: ["main"] # Altere para "master" se essa for a sua branch principal

  # Permite executar este fluxo manualmente na aba Actions do GitHub
  workflow_dispatch:

# Permissões necessárias para o GITHUB_TOKEN realizar o deploy
permissions:
  contents: read
  pages: write
  id-token: write

# Permite apenas um deploy concorrente por vez
concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Se o seu projeto usa Node.js (ex: React, Vue, Vite), descomente as linhas abaixo:
      # - name: Setup Node
      #   uses: actions/setup-node@v4
      #   with:
      #     node-version: 20
      #     cache: 'npm'
      # - name: Install dependencies
      #   run: npm ci
      # - name: Build
      #   run: npm run build

      - name: Setup Pages
        uses: actions/configure-pages@v4

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          # Altere 'dist' ou 'build' para a pasta onde ficam os arquivos prontos para publicação
          path: '.' 

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
